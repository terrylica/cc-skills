{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/plugins/marketplaces/cc-skills/plugins/chrome-profiles/hooks/browser-mcp-config-reminder.sh prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/plugins/marketplaces/cc-skills/plugins/chrome-profiles/hooks/browser-mcp-config-reminder.sh pretool",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
