{
  "description": "Braille Tally: every AskUserQuestion option carries a tally, in rank order (no legend in the question); every GitHub issue title an agent writes starts with a tally",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/hooks/askuserquestion-tally-guard.ts",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|mcp__.*__.*(create_issue|update_issue|issue_write)",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/hooks/issue-title-tally-guard.ts",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
