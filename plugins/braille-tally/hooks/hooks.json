{
  "description": "Braille Tally: every AskUserQuestion option carries a tally, with a legend, in rank order",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/hooks/askuserquestion-tally-guard.ts",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
