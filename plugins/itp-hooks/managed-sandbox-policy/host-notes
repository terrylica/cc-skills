#!/usr/bin/python3
"""host-notes: the "Claude Drafts" folder in Apple Notes, for agents INSIDE Claude Code's macOS sandbox.

The sandbox blocks Apple Events and the escape flag does not lift that for osascript, so this asks
the sandbox-diag-broker on 127.0.0.1 instead. It can only touch notes in "Claude Drafts":

  host-notes list                 JSON [{"id", "name"}] of the drafts
  host-notes get ID               the note's HTML body
  host-notes new    < body.html   creates a note; prints its id
  host-notes update ID < body.html  replaces that note's body; prints its id
  host-notes html2txt < body.html   plain text via textutil, which cannot run in the sandbox

There is no delete and no other folder. Used by notes-commander's draft-park when sandboxed.
"""

import argparse
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

PORT = os.environ.get("SANDBOX_DIAG_BROKER_PORT", "8797")
BASE = "http://127.0.0.1:" + PORT


def call(method, path, body=None):
    req = urllib.request.Request(BASE + path, data=body, method=method)
    if method == "POST":
        req.add_header("X-Sandbox-Broker", "1")
        req.add_header("Content-Type", "text/html; charset=utf-8")
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(req, timeout=90) as r:
            return r.read()
    except urllib.error.HTTPError as exc:
        sys.stderr.write("host-notes: " + exc.read().decode("utf-8", "replace"))
        sys.exit(1)
    except urllib.error.URLError as exc:
        sys.stderr.write("host-notes: broker unreachable on 127.0.0.1:" + PORT + " (" + str(exc.reason) + ")\n")
        sys.exit(2)


def main():
    ap = argparse.ArgumentParser(prog="host-notes", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("verb", choices=["list", "get", "new", "update", "html2txt"])
    ap.add_argument("id", nargs="?", help="note id (get, update)")
    a = ap.parse_args()
    if a.verb in ("get", "update") and not a.id:
        ap.error(a.verb + " needs a note id")
    if a.verb == "html2txt":
        # Written byte-for-byte: callers compare this text, so no trailing newline is added.
        sys.stdout.buffer.write(call("POST", "/text/html-to-txt", sys.stdin.buffer.read()))
        return
    if a.verb == "list":
        out = call("GET", "/notes/drafts")
    elif a.verb == "get":
        out = call("GET", "/notes/drafts/note?" + urllib.parse.urlencode({"id": a.id}))
    else:
        body = sys.stdin.buffer.read()
        path = "/notes/drafts" if a.verb == "new" else "/notes/drafts/note?" + urllib.parse.urlencode({"id": a.id})
        out = call("POST", path, body)
    sys.stdout.buffer.write(out)
    if not out.endswith(b"\n"):
        sys.stdout.buffer.write(b"\n")


if __name__ == "__main__":
    main()
