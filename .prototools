# proto — the only toolchain manager for this repo (jdx/mise is not used).
# Replaces the former `.mise.toml [tools]` block. Install everything pinned
# here on a fresh machine with a single `proto use`.
#
# Keep these pins concrete, never floating: the whole point of pinning is that
# two machines resolve the same binaries.

# proto pins ITSELF. 0.61.2 is a FLOOR with teeth, not a preference: every
# version before it writes an "AI agent environment" NDJSON banner to the STDOUT
# of tools invoked through a shim, which corrupts any stdout that carries a
# protocol. For this repo that meant Claude Code hook decisions — 2,008 of them
# silently discarded over three days while exit codes stayed 0, so a set of
# guards stopped applying and nothing reported an error.
#
# Reported as moonrepo/proto#1105 and fixed upstream the next day; the
# maintainer closed it with "Fixed in v0.61.2". Verified here on 0.61.2 with no
# workaround: 0/100 polluted at the 100-way concurrency that gave 27-45/100 on
# 0.61.1. tasks/release/preflight enforces this floor rather than trusting it.
proto = "0.61.3"

# Task orchestrator. Every entry point is a task in the root `moon.yml`.
moon = "2.5.4"

# Bun runs every script, CLI, hook and test in this marketplace.
bun = "1.4.0"

# Node exists ONLY for semantic-release, which does not support Bun
# (semantic-release/semantic-release#3527). Nothing else here should reach for
# it — if you are adding a Node dependency for anything other than the release
# pipeline, reach for Bun instead.
node = "26.8.1"
