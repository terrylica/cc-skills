#!/usr/bin/env bash
# Phase 2 of 4: Execute semantic-release to analyze conventional commits, determine version bump (patch/minor/major), update CHANGELOG.md, sync version across package.json + plugin.json + marketplace.json, create git tag, publish GitHub release, and push. Depends on preflight passing. Uses release.config.cjs configuration.
#
# The preflight dependency this description promises is declared in `moon.yml`
# under `release-version.deps`, NOT here. A `#MISE depends=["release:preflight"]`
# line used to sit here and was read by nothing (mise was retired in 60ea5956c39d30ace2e9e87216815e38d17b4ad8),
# so this publishing entry point tagged, changelogged, released and
# pushed with nothing validated (#138). This script has no self-guards, so the
# gate is orchestrator-level: `moon run repo:release-version` runs preflight
# first, a bare `bash tasks/release/version` does not.
set -euo pipefail

echo "═══════════════════════════════════════════════════════════"
echo "  Phase 2: VERSION (semantic-release)"
echo "═══════════════════════════════════════════════════════════"

# The pushes semantic-release makes (the release commit and tag, and the successCmd push)
# would otherwise re-run the whole repo:check through the pre-push gate (#142), minutes
# after preflight ran the same suites. Declared with a reason, never silently skipped.
export PREPUSH_GATE_OK="release push: release-preflight already ran the suites"

# The release commit must carry this repository's own identity. Left alone, semantic-release
# stamps its bot address, which the privacy gate's public-repo identity check refuses (only a
# GitHub noreply address passes), so the release commit failed after the version was computed.
# semantic-release honours these four variables over its defaults.
release_name="$(git config user.name)"
release_email="$(git config user.email)"
export GIT_AUTHOR_NAME="$release_name" GIT_COMMITTER_NAME="$release_name"
export GIT_AUTHOR_EMAIL="$release_email" GIT_COMMITTER_EMAIL="$release_email"

# Run semantic-release
semantic-release --no-ci

echo ""
echo "✓ Version phase complete"
echo ""
